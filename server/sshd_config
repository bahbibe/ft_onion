# ft_onion - server sshd_config
# Only reachable through the Tor hidden service (see torrc:
# HiddenServicePort 4242 127.0.0.1:4242). Key-only auth for the
# single test account; password login is disabled from the start.
# Bonus: SSH fortification - modern-only algorithms, tight auth
# limits, no forwarding, one host key.

Port 4242
ListenAddress 127.0.0.1
Protocol 2

# ed25519 only - drop RSA so no legacy algorithm is ever offered.
HostKey /etc/ssh/ssh_host_ed25519_key

KexAlgorithms curve25519-sha256,curve25519-sha256@libssh.org
Ciphers chacha20-poly1305@openssh.com,aes256-gcm@openssh.com,aes128-gcm@openssh.com
MACs hmac-sha2-512-etm@openssh.com,hmac-sha2-256-etm@openssh.com

PermitRootLogin no
PubkeyAuthentication yes
PasswordAuthentication no
PermitEmptyPasswords no
ChallengeResponseAuthentication no
KbdInteractiveAuthentication no
UsePAM yes

AllowUsers onion

MaxAuthTries 3
MaxSessions 2
LoginGraceTime 20
ClientAliveInterval 60
ClientAliveCountMax 2

DisableForwarding yes
X11Forwarding no
AllowAgentForwarding no
AllowTcpForwarding no
PermitTunnel no
GatewayPorts no

LogLevel VERBOSE

Subsystem sftp /usr/lib/openssh/sftp-server
